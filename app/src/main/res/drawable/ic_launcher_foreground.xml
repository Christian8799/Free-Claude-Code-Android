        <path
            android:fillColor="#f97316"
            android:pathData="M-30,-30 A12,12 0 1,1 -30.01,-30 Z" />
        <path
            android:fillColor="#f97316"
            android:pathData="M-30,0 A12,12 0 1,1 -30.01,0 Z" />
        <path
            android:fillColor="#f97316"
            android:pathData="M-30,30 A12,12 0 1,1 -30.01,30 Z" />

        <!-- Dark rounded square with orange border + play triangle - centered right -->
        <path
            android:fillColor="#080b12"
            android:pathData="M10,-22 L42,-22 A8,8 0 0,1 42,22 L10,22 A8,8 0 0,1 10,-22 Z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#f97316"
            android:strokeWidth="2"
            android:pathData="M11,-21 L41,-21 A7,7 0 0,1 41,21 L11,21 A7,7 0 0,1 11,-21 Z" />

        <!-- White play triangle (centered in square) -->
        <path
            android:fillColor="#f8fafc"
            android:pathData="M18,-12 L18,12 L36,0 Z" />
    </group>
</vector>